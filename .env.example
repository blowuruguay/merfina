# Postgres (Railway inyecta DATABASE_URL automáticamente al linkear el servicio)
DATABASE_URL=postgres://user:pass@host:5432/dbname

# Sesión
SESSION_SECRET=cambiar-por-algo-largo-y-random

# Admin (basic auth para /admin)
ADMIN_USER=mati
ADMIN_PASS=cambiar

# MercadoPago (sacar access token desde https://www.mercadopago.com.uy/developers/panel/app)
MP_ACCESS_TOKEN=APP_USR-xxxxx
MP_PUBLIC_KEY=APP_USR-xxxxx

# URL pública del sitio (para callbacks de MP)
PUBLIC_URL=https://merfina-production.up.railway.app

# Envío flat UYU (en centésimos)
SHIPPING_FLAT_CENTS=19000

# WhatsApp
WHATSAPP_NUMBER=59891900341
